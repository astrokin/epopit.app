rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /contactRequests/{requestId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'message',
          'source',
          'page',
          'userAgent',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.source == 'epopit.app'
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 120
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
